---
import { projects } from '../data/site';
---

<section id="proyectos" class="scroll-mt-24 border-t border-line py-20 lg:py-28" aria-labelledby="proyectos-heading">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">Desarrollo web</p>
      <h2 id="proyectos-heading" class="mt-4 text-[clamp(1.9rem,4vw,2.7rem)]">Proyectos</h2>
      <p class="mt-3 text-secondary">Front-end aplicado a casos reales.</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {
        projects.map((p, i) => (
          <article
            class={`crop-host tilt reveal reveal-d${(i % 2) + 1} relative flex flex-col rounded-md border border-line bg-surface p-7 transition-[transform,border-color] duration-300 hover:-translate-y-1.5 hover:border-violet-light lg:p-9`}
          >
            <span class="crop crop-tl" /><span class="crop crop-tr" />
            <span class="crop crop-bl" /><span class="crop crop-br" />

            <div class="mb-4 font-mono text-xs tracking-[0.05em] text-accent">
              <span class="text-muted">P.</span>
              {p.number}
            </div>
            <h3 class="text-xl font-bold text-primary lg:text-2xl">{p.title}</h3>
            <p class="mt-3 grow leading-relaxed text-secondary">{p.description}</p>

            <div class="mt-6 flex flex-wrap gap-2">
              {p.tech.map((t) => (
                <span class="rounded-xs border border-violet/30 bg-violet/10 px-2.5 py-1 font-mono text-[0.72rem] text-tag">
                  {t}
                </span>
              ))}
            </div>

            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="magnetic mt-7 inline-flex w-fit items-center gap-2 rounded-sm bg-lime px-5 py-3 text-sm font-bold text-lime-ink transition-[transform,box-shadow] hover:-translate-y-0.5 hover:shadow-[0_10px_24px_-6px_rgba(215,255,63,0.4)]"
              aria-label={`Ver proyecto: ${p.title} (se abre en una pestaña nueva)`}
            >
              Ver proyecto
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"
                ><path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
