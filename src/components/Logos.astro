---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { logos } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.png', { eager: true });
const img = (slug: string) => files[`../assets/logos/${slug}.png`].default;

// clones: last 2 + real 8 + first 2  → seamless loop
const CL = 2;
const seq = [
  ...logos.slice(-CL).map((l) => ({ ...l, clone: true })),
  ...logos.map((l) => ({ ...l, clone: false })),
  ...logos.slice(0, CL).map((l) => ({ ...l, clone: true })),
];
---

<section id="logos" class="scroll-mt-24 border-t border-line py-20 lg:py-28" aria-labelledby="logos-heading">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">Identidad visual</p>
      <h2 id="logos-heading" class="mt-4 text-[clamp(1.9rem,4vw,2.7rem)]">Logotipos creados</h2>
      <p class="mt-3 text-secondary">Donde la creatividad se encuentra con la estrategia de marca.</p>
    </div>

    <div class="reveal reveal-d1 mt-12">
      <div class="carousel relative flex items-center gap-3" data-carousel>
        <button
          type="button"
          class="carousel-arrow grid h-11 w-11 flex-none place-items-center rounded-full border border-line-strong bg-surface text-primary transition-[background,border-color,transform] hover:scale-105 hover:border-violet hover:bg-violet hover:text-white max-[560px]:hidden"
          data-prev
          aria-label="Logo anterior"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"
            ><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>

        <div class="carousel-fade min-w-0 flex-1 overflow-hidden" data-viewport>
          <div
            class="flex gap-6 will-change-transform"
            data-track
            role="region"
            aria-roledescription="carrusel"
            aria-label="Logotipos creados"
            tabindex="0"
          >
            {
              seq.map((l, i) => (
                <article
                  class="crop-host logo-slide relative w-[clamp(260px,68vw,560px)] flex-none rounded-md border border-line bg-surface p-4 pb-6 text-center transition-[transform,border-color,background] duration-300 hover:-translate-y-1.5 hover:border-violet-light hover:bg-surface-2"
                  aria-hidden={l.clone ? 'true' : undefined}
                  aria-label={l.clone ? undefined : l.title}
                >
                  <span class="crop crop-tl" /><span class="crop crop-tr" />
                  <span class="crop crop-bl" /><span class="crop crop-br" />
                  <span class="absolute left-5 top-4 font-mono text-[0.7rem] tracking-[0.05em] text-muted">{l.index}</span>
                  <div class="mb-4 mt-7 overflow-hidden rounded-sm">
                    <Image
                      src={img(l.slug)}
                      alt={l.clone ? '' : l.title}
                      widths={[280, 420, 560]}
                      sizes="(max-width: 560px) 68vw, 560px"
                      loading="lazy"
                      class="block h-auto w-full select-none rounded-[10px]"
                      draggable={false}
                    />
                  </div>
                  <div class="flex flex-wrap justify-center gap-1.5">
                    {l.tags.map((t) => (
                      <span
                        class="rounded-xs px-2.5 py-1 font-mono text-[0.72rem] font-medium text-white"
                        style={`background:${l.gradient}`}
                      >
                        {t}
                      </span>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <button
          type="button"
          class="carousel-arrow grid h-11 w-11 flex-none place-items-center rounded-full border border-line-strong bg-surface text-primary transition-[background,border-color,transform] hover:scale-105 hover:border-violet hover:bg-violet hover:text-white max-[560px]:hidden"
          data-next
          aria-label="Logo siguiente"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true"
            ><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>

      <div class="mt-7 flex justify-center gap-2.5" data-dots aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  import { initCarousel } from '../scripts/carousel';
  initCarousel();
</script>
