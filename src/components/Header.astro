---
import { nav, site } from '../data/site';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background,border-color,backdrop-filter] duration-300"
  data-header
>
  <div class="mx-auto flex h-[70px] max-w-[1240px] items-center justify-between px-5 lg:px-8">
    <!-- Brand -->
    <a
      href="#inicio"
      class="group inline-flex items-center gap-3 focus:outline-none"
      aria-label={`${site.name} — inicio`}
    >
      <span class="grid h-9 w-9 place-items-center rounded-[9px] border border-line-strong bg-surface transition-colors group-hover:border-lime">
        <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" aria-hidden="true">
          <path d="M5 19V5l14 14V5" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" />
        </svg>
      </span>
      <span class="font-mono text-[0.7rem] font-semibold uppercase leading-[1.2] tracking-[0.06em] text-primary">
        Nicolás<br />Zorrilla
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link group inline-flex items-center gap-1.5 font-mono text-[0.85rem] text-secondary transition-colors hover:text-primary"
          >
            <span class="text-[0.72rem] text-accent">{item.index}</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2.5">
      <a
        href="#contacto"
        class="magnetic hidden items-center gap-2 rounded-sm bg-lime px-4 py-2.5 text-sm font-semibold text-lime-ink transition-[background,transform] hover:-translate-y-0.5 md:inline-flex"
      >
        Trabajemos juntos
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"
          ><path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
        /></svg>
      </a>

      <!-- Theme toggle -->
      <button
        type="button"
        id="theme-toggle"
        class="grid h-10 w-10 place-items-center rounded-[10px] border border-line-strong bg-surface text-primary transition-colors hover:border-lime"
        aria-label="Cambiar tema"
      >
        <svg class="h-5 w-5 light:hidden" data-icon-moon viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
        /></svg>
        <svg class="hidden h-5 w-5 light:block" data-icon-sun viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" /><path
            d="M12 2v2M12 20v2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M18.4 5.6l1.4-1.4M4.2 19.8l1.4-1.4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          /></svg>
      </button>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="menu-open"
        class="grid h-10 w-10 place-items-center rounded-[10px] border border-line-strong text-primary md:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden translate-y-0 bg-ink px-5 pt-5 md:hidden"
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <span class="font-mono text-[0.7rem] font-semibold uppercase tracking-[0.06em] text-primary">Nicolás Zorrilla</span>
    <button
      type="button"
      id="menu-close"
      class="grid h-10 w-10 place-items-center rounded-[10px] border border-line-strong text-primary"
      aria-label="Cerrar menú"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav class="mt-14 flex flex-col border-t border-line" aria-label="Navegación móvil">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="mobile-link flex min-h-16 items-center justify-between border-b border-line text-2xl font-medium tracking-tight text-primary"
        >
          <span class="flex items-center gap-3">
            <span class="font-mono text-sm text-accent">{item.index}</span>
            {item.label}
          </span>
          <svg viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="none" aria-hidden="true"
            ><path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
          /></svg>
        </a>
      ))
    }
  </nav>
  <a
    href="#contacto"
    class="mobile-link mt-8 flex min-h-12 items-center justify-center gap-2 rounded-sm bg-lime px-5 text-sm font-semibold text-lime-ink"
  >
    Trabajemos juntos
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"
      ><path d="M7 17L17 7M17 7H9M17 7v8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </a>
</div>
