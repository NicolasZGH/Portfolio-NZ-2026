---
import { site } from '../data/site';

const items = [
  {
    href: `mailto:${site.email}`,
    label: site.email,
    icon: 'M3 6.5 12 13l9-6.5M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z',
    ext: false,
  },
  {
    href: site.phoneHref,
    label: site.phone,
    icon: 'M6.5 3h3l1.5 4-2 1.5a11 11 0 0 0 4.5 4.5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A15 15 0 0 1 4.5 5a2 2 0 0 1 2-2Z',
    ext: false,
  },
  {
    href: site.github,
    label: site.githubLabel,
    icon: 'M9 19c-4 1.4-4-2-5-2m10 4v-3a3 3 0 0 0-.8-2.3c2.6-.3 5.4-1.3 5.4-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.9 2.2 5.9 2.5 5.9 2.5a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.5 9c0 4.6 2.8 5.6 5.4 6a3 3 0 0 0-.8 2.3V21',
    ext: true,
  },
];
---

<section id="contacto" class="scroll-mt-24 border-t border-line py-20 lg:py-28" aria-labelledby="contacto-heading">
  <div class="mx-auto max-w-[1240px] px-5 lg:px-8">
    <div class="crop-host crop-always grid-field reveal relative overflow-hidden rounded-lg border border-line p-8 text-center sm:p-14">
      <span class="crop crop-tl"></span><span class="crop crop-tr"></span>
      <span class="crop crop-bl"></span><span class="crop crop-br"></span>

      <p class="eyebrow justify-center">Contacto</p>
      <h2 id="contacto-heading" class="mx-auto mt-4 max-w-2xl text-[clamp(1.8rem,4vw,2.6rem)]">
        ¿Interesado en <span class="text-flow">trabajar juntos</span>?
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-secondary">
        Creo soluciones web a medida que impulsan el crecimiento de tu marca.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        {
          items.map((it) => (
            <a
              href={it.href}
              target={it.ext ? '_blank' : undefined}
              rel={it.ext ? 'noopener noreferrer' : undefined}
              class="magnetic inline-flex items-center gap-2.5 rounded-sm border border-line bg-surface-2 px-4 py-3 font-mono text-sm text-primary transition-[transform,border-color] hover:-translate-y-0.5 hover:border-violet-light"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-accent" fill="none" aria-hidden="true">
                <path d={it.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {it.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
